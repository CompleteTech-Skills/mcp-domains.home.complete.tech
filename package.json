{
  "name": "complete-tech-domain-suite-mcp",
  "version": "0.1.0",
  "description": "MCP server for domain discovery, registrar comparison, heuristic scoring, and guarded domain registration.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "complete-tech-domain-suite": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/server-http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/server-http.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^25.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/**/*.js",
    "skills/domain-buyer/SKILL.md",
    "skills/domain-buyer/agents/openai.yaml",
    ".env.example"
  ]
}
